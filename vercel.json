{
  "version": 2,
  "buildCommand": "cd frontend && npm install && node node_modules/vite/bin/vite.js build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://jac-attendance-backend-5inu.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://jac-attendance-backend-5inu.onrender.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
